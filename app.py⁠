# -------------------------------------------------------------------
# 1. Google Custom Search 用関数
# -------------------------------------------------------------------
def search_google(query, api_key, cx, num_results=4):
    url = "https://www.googleapis.com/customsearch/v1"
    params = {"key": api_key, "cx": cx, "q": query, "num": num_results}
    try:
        response = requests.get(url, params=params)
        data = response.json()
        results = []
        if "items" in data:
            for item in data["items"]:
                results.append({
                    "title": item.get("title"),
                    "link": item.get("link"),
                    "snippet": item.get("snippet")
                })
        return results
    except Exception as e:
        st.error(f"Google検索エラー: {e}")
        return []

def verify_with_google_and_gpt(text, search_results, openai_api_key):
    client = OpenAI(api_key=openai_api_key)
    context = ""
    for idx, res in enumerate(search_results, 1):
        context += f"[{idx}] タイトル: {res['title']}\n概要: {res['snippet']}\nURL: {res['link']}\n\n"

    prompt = f"""
以下の「検証対象テキスト」について、添付された「Web検索結果」を根拠にしてファクトチェックを行ってください。

【検証対象テキスト】
{text}

【参照されたWeb検索結果】
{context if context else "（有効な検索結果が得られませんでした）"}

【指示】
・テキストの真偽（正確/一部誤り/誤り/根拠なし）を判断してください。
・信頼度スコア（0〜100%）を明記してください。
・結論と理由をわかりやすく箇条書きでまとめてください。
"""
    response = client.chat.completions.create(
        model="gpt-4o",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.2
    )
    return response.choices[0].message.content


# -------------------------------------------------------------------
# 2. Perplexity API 用関数
# -------------------------------------------------------------------
def verify_with_perplexity(text, perplexity_api_key):
    url = "https://api.perplexity.ai/chat/completions"
    headers = {
        "Authorization": f"Bearer {perplexity_api_key}",
        "Content-Type": "application/json"
    }
    prompt = f"""
以下のテキストについてファクトチェックを行い、最新のWeb情報に基づいた検証結果と信頼度スコア（0〜100%）を出力してください。

【検証対象テキスト】
{text}
"""
    payload = {
        "model": "sonar-pro",
        "messages": [
            {"role": "system", "content": "あなたは公正かつ正確なファクトチェッカーです。分析結果と信頼度スコアを出力してください。"},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.2
    }
    
    try:
        response = requests.post(url, headers=headers, json=payload)
        data = response.json()
        
        answer = data['choices'][0]['message']['content']
        citations = data.get('citations', [])
        return answer, citations
    except Exception as e:
        st.error(f"Perplexity API エラー: {e}")
        return None, []


