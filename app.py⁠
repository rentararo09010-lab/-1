st.set_page_config(page_title="AI Fact Checker Pro", layout="wide")
st.title("🔍 AI Fact Checker Pro")
st.write("Google Custom Search または Perplexity API を選択してWeb上の最新根拠を取得し、ファクトチェックを行います。")

# サイドバーの設定
with st.sidebar:
    st.header("⚙️ 設定・APIキー")
    
    # 検索エンジンの選択
    search_engine = st.radio(
